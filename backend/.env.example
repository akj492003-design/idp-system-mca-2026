# Flask/API
FLASK_ENV=production
SECRET_KEY=replace-with-a-cryptographically-random-32-byte-or-longer-secret
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
MAX_UPLOAD_MB=10
FILE_STORAGE_PATH=./storage

# MongoDB / Redis
MONGODB_URI=mongodb://localhost:27017/?retryWrites=true&w=majority
MONGODB_DB=idp_system
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Google OAuth Web application credentials. Client ID is public; secret is backend-only.
GOOGLE_CLIENT_ID=353947844670-lsbskhur78m5b51m97s06ji2719a2vud.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=postmessage

# Brevo transactional email. Put a newly generated, rotated API key in backend/.env.
BREVO_API_KEY=replace-with-a-new-brevo-api-key
BREVO_SENDER_EMAIL=security@your-verified-domain.example
BREVO_EMAIL_SENDER_NAME=IDP System
BREVO_SMS_SENDER=IDPSystem
RESET_TOKEN_TTL_MINUTES=30

# Razorpay (optional; leave blank until checkout is configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Model loading / OCR
MODEL_ASSETS_PATH=./app/assets/models
PADDLEOCR_LANG=en
PADDLE_PDX_MODEL_SOURCE=bos
PADDLE_PDX_CACHE_HOME=/app/model_cache
ENABLE_IMAGE_CLASSIFIER=true
