# Flask API base URL. Keep the /api prefix if your Flask routes use it.
VITE_API_BASE_URL=http://localhost:5000/api

# Public Google OAuth Web Client ID (never put the Google client secret here).
VITE_GOOGLE_CLIENT_ID=353947844670-lsbskhur78m5b51m97s06ji2719a2vud.apps.googleusercontent.com

# Set true only when intentionally running the frontend without the backend.
VITE_DEMO_MODE=false

# Client-side PDF upload limit (the backend MAX_UPLOAD_MB must match).
VITE_MAX_PDF_SIZE_MB=10
